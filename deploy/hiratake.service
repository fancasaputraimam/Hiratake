; ============================================================
;  systemd unit — jalan tanpa Docker
;  Pasang:
;    sudo cp deploy/hiratake.service /etc/systemd/system/
;    sudo systemctl daemon-reload
;    sudo systemctl enable --now hiratake
;  Lihat log:  sudo journalctl -u hiratake -f
; ============================================================
[Unit]
Description=Hiratake - Web Jamur Tiram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hiratake
Group=hiratake
WorkingDirectory=/var/www/hiratake
EnvironmentFile=-/var/www/hiratake/.env
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Pengamanan dasar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/hiratake/data

[Install]
WantedBy=multi-user.target
