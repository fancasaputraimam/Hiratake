{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i assets/tailwind-input.css -o public/static/tailwind.css --minify",
    "build": "npm run build:css && vite build",
    "watch:css": "tailwindcss -i assets/tailwind-input.css -o public/static/tailwind.css --watch",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build:vps": "npm run build",
    "start": "node server/index.mjs",
    "start:vps": "node server/index.mjs",
    "migrasi:vps": "node server/migrasi.mjs",
    "backup:vps": "node server/backup.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
