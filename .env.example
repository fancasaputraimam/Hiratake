# ============================================================
#  Contoh konfigurasi server VPS
#  Copy jadi `.env` lalu sesuaikan:   cp .env.example .env
#  CATATAN: file .env JANGAN di-commit ke git.
# ============================================================

# --- Jaringan ---
PORT=3000
HOST=127.0.0.1          # 127.0.0.1 bila di belakang nginx; 0.0.0.0 bila langsung

# --- Database (SQLite, satu file) ---
DB_FILE=data/hiratake.sqlite
MIGRASI_DIR=migrations
AUTO_MIGRASI=1          # 1 = migrasi otomatis saat start, 0 = manual
AUTO_SEED=1             # 1 = isi data awal HANYA bila database masih kosong

# --- Backup otomatis ---
BACKUP_DIR=data/backup
BACKUP_SIMPAN=14        # jumlah file backup yang disimpan
BACKUP_JAM=24           # interval backup dalam jam

# --- WhatsApp / OpenWA (opsional; notifikasi, OTP login, auto-reply) ---
# Kosongkan seluruh blok bila tidak memakai fitur WhatsApp.
# Nilai di sini MENANG atas pengaturan dashboard — praktis untuk VPS:
# isi sekali di .env, integrasi langsung siap tanpa buka dashboard.
# CATATAN: jangan taruh komentar di belakang nilai (parser .env membacanya
# sebagai bagian dari nilai). Tulis nilainya saja.
#
# URL gateway OpenWA. OpenWA di VPS yang sama -> http://127.0.0.1:2785
OPENWA_URL=
# Nama sessionId yang dibuat di dashboard OpenWA (mis: hiratake)
OPENWA_SESSION=
# 1 = aktifkan integrasi tanpa perlu menyalakan saklar di dashboard
OPENWA_AKTIF=
# X-API-Key dari dashboard OpenWA (hanya tampil sekali saat dibuat)
OPENWA_API_KEY=
# Secret verifikasi webhook: teks acak min. 20 karakter; nilai sama dipasang di OpenWA
OPENWA_WEBHOOK_SECRET=

# --- Pembayaran (opsional; hanya bila memakai payment gateway) ---
BAYAR_CLIENT_KEY=
BAYAR_SERVER_KEY=
BAYAR_CALLBACK_SECRET=

# --- Lain-lain ---
PUBLIC_DIR=./public
WORKER_FILE=dist/_worker.js
